// Only needed for local signing in Xcode; the Codemagic build sets the team itself.
// Keep this file ASCII-only: Codemagic's xcode-project tools parse it with Ruby's xcodeproj.
TEAM_ID=

PRODUCT_NAME=Sternengarten
PRODUCT_BUNDLE_IDENTIFIER=de.vcxrisi.sternengarten

// Replaced by $BUILD_NUMBER on every Codemagic build (see codemagic.yaml).
CURRENT_PROJECT_VERSION=1
MARKETING_VERSION=1.0
